<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eatnow.backend.dish.mapper.TagMapper">

    <select id="selectActiveTags" resultType="com.eatnow.backend.dish.vo.TagVo">
        SELECT
            id,
            name,
            type,
            status
        FROM tag
        WHERE status = 'ACTIVE'
        <if test="type != null and type != ''">
            AND type = #{type}
        </if>
        ORDER BY sort_order ASC, id ASC
    </select>
</mapper>
