<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eatnow.backend.dish.mapper.CategoryMapper">

    <select id="selectActiveCategories" resultType="com.eatnow.backend.dish.vo.CategoryVo">
        SELECT
            id,
            name,
            type,
            sort_order AS sortOrder,
            status
        FROM category
        WHERE status = 'ACTIVE'
        <if test="type != null and type != ''">
            AND type = #{type}
        </if>
        ORDER BY sort_order ASC, id ASC
    </select>
</mapper>
